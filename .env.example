# Copy this file to .env.local (dev) or .env (other environments) and fill
# in real values. This file lists every environment variable the app
# actually reads — see `grep -rho "process\.env\.[A-Z_]*" src supabase` to
# regenerate the list if it drifts.

# ── Required — the app will not start without these ──────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ── Supabase service-role access (webhooks, admin operations) ────────────
# Only one of these needs to be set; EDGE_SERVICE_ROLE_KEY is checked first
# in files that fall back between the two. Never expose either client-side.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
EDGE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── App URL / versioning ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=0.1.0

# ── Stripe (subscriptions) ────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PRICE_ID=price_your_price_id
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ── Sentry Error Tracking (optional — leave blank to disable) ────────────
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id

# ── E2E / test scripts ────────────────────────────────────────────────────
TEST_USER_EMAIL=your_test_email@example.com
TEST_USER_PASSWORD=your_strong_password
# Base URL some scripts/tests hit instead of NEXT_PUBLIC_APP_URL
BASE_URL=http://localhost:3000
