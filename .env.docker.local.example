# Local Docker Testing Overrides
#
# Copy this file to .env.docker.local and override any values from .env.docker
# for safe local testing. This file is optional — docker-compose.yml picks it
# up automatically if present.
#
# IMPORTANT: This file should NOT be committed to git.

# ── Build-time overrides ─────────────────────────────────────────────────────
# Use http://localhost:3000 for local testing so Supabase Secure cookies work
# correctly over plain HTTP. Without this, auth session cookies are rejected
# by the browser and the app constantly redirects to /login.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Runtime overrides ────────────────────────────────────────────────────────
# Change the host port if 3000 is already in use on your machine.
HOST_PORT=3000
