# =============================================================================
# .env.docker.example
#
# Copy this file to .env.docker and fill in your real values.
# .env.docker is gitignored and should NEVER be committed.
#
# Split into two groups:
#   BUILD-TIME  — must be provided when running `docker build` (or docker compose build)
#   RUNTIME     — provided to the running container; never baked into the image
# =============================================================================

# -----------------------------------------------------------------------------
# Docker image naming (used by docker-compose.yml)
# -----------------------------------------------------------------------------
DOCKER_IMAGE_NAME=yourdockerhubusername/meal-planner
DOCKER_IMAGE_TAG=latest

# Port the app is accessible on your host / Unraid server
HOST_PORT=3000

# =============================================================================
# BUILD-TIME variables (NEXT_PUBLIC_* are inlined into the JS bundle)
# =============================================================================

# Supabase — find these in your Supabase project dashboard under
# Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# The public URL your app will be served from.
# Use your Unraid server's local IP, e.g. http://192.168.1.50:3000
# Or your domain/subdomain if you set up a reverse proxy.
NEXT_PUBLIC_APP_URL=http://192.168.1.50:3000

# Sentry — find this in your Sentry project under Settings > Client Keys (DSN)
# Leave blank to disable Sentry error reporting
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oxxxx.ingest.sentry.io/xxxx

# App version — automatically read from VERSION file by build.ps1
# Only set this if you want to override the version in VERSION file
# NEXT_PUBLIC_APP_VERSION=0.1.0

# =============================================================================
# RUNTIME variables (injected into the running container, never in the image)
# =============================================================================

# Supabase service role key — Settings > API > service_role (keep secret!)
SUPABASE_SERVICE_ROLE_KEY=eyJ...
EDGE_SERVICE_ROLE_KEY=eyJ...

# Stripe — find these in your Stripe dashboard
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
